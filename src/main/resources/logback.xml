<configuration>
    <!-- One JSON object per line (logstash-logback-encoder): timestamp, level, logger, message, MDC (correlationId),
         stack traces as a single field. Ready for Loki / ELK / CloudWatch without any parsing rules. -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdc>true</includeMdc>
            <customFields>{"service":"clinic-scheduler"}</customFields>
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerThrowable>30</maxDepthPerThrowable>
                <rootCauseFirst>true</rootCauseFirst>
            </throwableConverter>
        </encoder>
    </appender>

    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="org.flywaydb" level="INFO"/>
    <logger name="Exposed" level="WARN"/>
    <logger name="io.netty" level="WARN"/>

    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="JSON"/>
    </root>
</configuration>
