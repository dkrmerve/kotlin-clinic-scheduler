<configuration>
    <!-- Plain text and quiet for the test run; production uses the JSON encoder in src/main/resources/logback.xml. -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%X{correlationId}] %logger{24} - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="com.dkrmerve.clinic" level="WARN"/>
    <logger name="org.testcontainers" level="WARN"/>
    <logger name="com.github.dockerjava" level="WARN"/>
    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
