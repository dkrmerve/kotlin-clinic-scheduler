# Copy to .env for `docker compose up`. Values here are LOCAL DEVELOPMENT defaults, not secrets.
# See README "Configuration" for every variable and its default.

# --- database (compose wires the app to the postgres service with these) ---
POSTGRES_DB=clinic
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic

# --- authentication: development HMAC mode ---
# At least 32 characters. Generate a real one with: openssl rand -hex 32
AUTH_DEV_SIGNING_KEY=dev-only-signing-key-change-me-0123456789abcdef
AUTH_DEV_ISSUER=clinic-scheduler-dev
# Enables POST /auth/token (mint dev tokens). Must be false in any shared environment.
AUTH_DEV_ISSUER_ENABLED=true

# --- authentication: production OIDC mode (set all three; disables the dev issuer) ---
# AUTH_JWKS_URL=https://login.example.com/.well-known/jwks.json
# AUTH_ISSUER=https://login.example.com/
# AUTH_AUDIENCE=clinic-scheduler

# --- scheduling policy ---
CLINIC_ZONE=Europe/Amsterdam
BOOKING_HORIZON_DAYS=60
FREE_CANCEL_HOURS=24
MIN_CANCEL_HOURS=2
NO_SHOW_LIMIT=3
NO_SHOW_WINDOW_DAYS=90
BLOCK_DAYS=30

# --- limits and operations ---
RATE_LIMIT_PER_MINUTE=120
MAX_BODY_BYTES=65536
LOG_LEVEL=INFO
